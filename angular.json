{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "centro-escolar": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ce",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "data", "output": "data" },
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "**/*", "input": "pages", "output": "pages" },
              { "glob": "**/*", "input": "css", "output": "css" },
              { "glob": "**/*", "input": "js", "output": "js" }
            ],
            "styles": ["src/styles.css"],
            "outputPath": "dist/centro-escolar"
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }], "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "production": { "buildTarget": "centro-escolar:build:production" }, "development": { "buildTarget": "centro-escolar:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": {
    "analytics": "5fa51967-4e20-4d3a-a32c-4d6ff0791b80"
  }
}
